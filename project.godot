; Archivo de configuración del motor (Godot 4.3).
config_version=5

[application]

config/name="Golazo Pro 3D"
config/description="Juego de fútbol 3D original para Android (uso personal)."
config/version="0.2.0"
run/main_scene="res://scenes/match/match.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"
config/quit_on_go_back=false

[autoload]

GameSettings="*res://scripts/core/game_settings.gd"
Lang="*res://scripts/core/lang.gd"
InputHub="*res://scripts/core/input_hub.gd"
DB="*res://scripts/core/database.gd"
Game="*res://scripts/core/game_state.gd"
Audio="*res://scripts/core/audio_manager.gd"

[audio]

general/text_to_speech=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
rendering_device/fallback_to_opengl3=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
anti_aliasing/quality/msaa_3d=1
